NODE_ENV=development
APP_PORT=3000

DB_CLIENT=mysql2
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pos_venda

FRONTEND_URL=http://localhost:5173

JWT_SECRET=sua_chave_secreta_aqui
JWT_EXPIRES_IN=1d

VENDA_ARQUIVOS_STORAGE_DIR=
VENDA_ARQUIVOS_MAX_FILE_MB=50
VENDA_ARQUIVOS_MAX_FILES_PER_VENDA=30
VENDA_ARQUIVOS_RETENCAO_INDIVIDUAIS_DIAS=30
VENDA_ARQUIVOS_ALLOWED_TYPES=application/pdf,image/jpeg,image/png,image/webp

TELEGRAM_BOT_TOKEN=
TELEGRAM_FUTUROS_CLIENTES_CHAT_ID=

# URL publica HTTPS: https://seu-dominio/api/telegram/webhook
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# IDs numericos do Telegram dos gerentes, separados por virgula
TELEGRAM_GERENTE_USER_IDS=

# Executa migrations pendentes antes de abrir a API
AUTO_MIGRATE=false

# Integração com o dashboard de vendas. Mantenha a chave somente no cofre de
# segredos/variáveis do ambiente de produção; sem ambas as variáveis, novas
# vendas são salvas no CRM com status de erro de integração.
DASHBOARD_INTEGRATION_URL=https://seu-dominio-dashboard
DASHBOARD_INTEGRATION_API_KEY=

# Opcional: JSON para mapear IDs locais aos IDs do dashboard quando os nomes
# não coincidirem.
# DASHBOARD_INTEGRATION_SELLER_MAP={"1":10}
# DASHBOARD_INTEGRATION_SERVICE_MAP={"1":20}
# DASHBOARD_INTEGRATION_OPERATOR_MAP={"1":30}
# DASHBOARD_INTEGRATION_SALE_TYPE_MAP={"1":40}
# Exceção temporária, para liberar reenvio manual de uma venda já existente.
# Informe apenas os IDs necessários, separados por vírgula, e remova após o envio.
# DASHBOARD_INTEGRATION_MANUAL_RETRY_SALE_IDS=123


TELEGRAM_RESUMO_VENDAS_CHAT_ID=
TELEGRAM_VENDAS_CHAT_ID=
TELEGRAM_RESUMO_VENDAS_AGENDAMENTO_ATIVO=false
